# ── Supabase ──────────────────────────────────────────────────────────
# Painel do Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Usada APENAS no servidor (mutações administrativas, nunca exposta ao
# browser). Em produção: npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# ── Revalidação sob demanda ───────────────────────────────────────────
# Token para o endpoint /api/revalidate (webhook do Supabase → site).
# Gere com: openssl rand -hex 32
REVALIDATE_SECRET=troque-este-valor

# ── Geração de tipos (npm run db:types) ───────────────────────────────
SUPABASE_PROJECT_ID=seu-project-id
