# ── Supabase ──────────────────────────────────────────────────────────
# Painel do Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Usada APENAS no servidor (mutações admin, exclusão de conta, vínculo
# WCA). Nunca exposta ao browser. Produção: wrangler secret put ...
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# ── URL pública do site (para redirects de OAuth) ─────────────────────
# Ex: https://cubingsp-site.matcasviana.workers.dev  (ou domínio próprio)
NEXT_PUBLIC_SITE_URL=https://cubingsp-site.SEU-SUBDOMINIO.workers.dev

# ── Ferramenta de Súmulas (OAuth implícito, client-side) ──────────────
# Registre um app SEPARADO em:
# https://www.worldcubeassociation.org/oauth/applications/new
# Redirect URI: <NEXT_PUBLIC_SITE_URL>/ferramentas/sumulas
#   (adicione também /en/tools/scorecards e /es/herramientas/sumulas)
# Escopos: public manage_competitions — sem client secret (fluxo implícito).
NEXT_PUBLIC_WCA_TOOL_CLIENT_ID=seu-wca-tool-client-id

# ── Login com WCA (OAuth customizado) ─────────────────────────────────
# Registre o app em: https://www.worldcubeassociation.org/oauth/applications/new
# Redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/wca/callback
WCA_CLIENT_ID=seu-wca-client-id
WCA_CLIENT_SECRET=seu-wca-client-secret

# ── Revalidação sob demanda ───────────────────────────────────────────
# Token para o endpoint /api/revalidate (webhook do Supabase → site).
# Gere com: openssl rand -hex 32
REVALIDATE_SECRET=troque-este-valor

# ── Geração de tipos (npm run db:types) ───────────────────────────────
SUPABASE_PROJECT_ID=seu-project-id
