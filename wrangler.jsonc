{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cubingsp",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  // Assets estáticos (HTML pré-renderizado, JS, CSS, imagens) são
  // servidos GRATUITAMENTE e de forma ILIMITADA — não contam nas
  // 100.000 requisições/dia do Worker. Esta é a base de toda a
  // estratégia de proteção de cota.
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Bucket R2 para o cache incremental (ISR) do OpenNext.
  // Criar com: npx wrangler r2 bucket create cubingsp-isr-cache
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "cubingsp-isr-cache"
    }
  ],

  // Variáveis (Supabase, WCA, hub de ferramentas…) ficam no painel da
  // Cloudflare: Worker → Settings → Variables and Secrets. Não coloque
  // valores de exemplo aqui: o site trataria o Supabase como configurado e
  // tentaria acessar um endereço inexistente a cada requisição.
  // keep_vars: o deploy feito a partir do repositório NÃO apaga as
  // variáveis cadastradas no painel.
  "keep_vars": true,

  "observability": {
    "enabled": true
  }
}
